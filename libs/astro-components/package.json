{
  "name": "@purrtrait/astro-components",
  "version": "0.0.1",
  "description": "Purrtrait Astro components.",
  "keywords": [
    "library",
    "rendering",
    "astro",
    "documentation"
  ],
  "author": "Noodlestan Collective",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/noodlestan/purrtrait.git",
    "directory": "libs/astro-components"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE-MIT",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*"
  },
  "scripts": {
    "dev": "vite build --watch",
    "lint": "prettier . -c && eslint . && tsc --noEmit",
    "lint:fix": "prettier . -c --write && eslint . --fix",
    "build": "vite build",
    "build:clean": "rm -rf dist",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "ci": "npm run lint && npm run build && npm run test:ci"
  },
  "dependencies": {
    "@purrtrait/code-renderer": "0.0.11",
    "@purrtrait/lang-ts": "0.0.11",
    "marked": "18.1.2"
  },
  "peerDependencies": {
    "astro": "^7",
    "shiki": "^4"
  },
  "devDependencies": {
    "@purrception/lang-ts": "0.1.1"
  }
}
